+    @staticmethod
+    @torch.compile(dynamic=False, fullgraph=True)
+    def _apply_aurora_row_balance(v_chunk):
+        """
+        One cheap Aurora-style post-balance pass.
+
+        This is intentionally lighter than full Aurora: it does not rerun the
+        polar map. It equalizes per-row energy after NorMuon's variance
+        reduction, aiming to get Aurora's dead-row protection with one
+        row-stat reduction and one broadcast multiply.
+        """
+        row_sq = v_chunk.float().square().mean(dim=-1, keepdim=True).clamp_min_(1e-10)
+        target = row_sq.mean(dim=-2, keepdim=True)
+        scale = (target / row_sq).sqrt_().type_as(v_chunk)
+        return v_chunk.mul_(scale)
